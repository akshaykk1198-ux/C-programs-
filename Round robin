#include<stdio.h>

int main()
{
    int n,i,tq,remain;
    int bt[20],rt[20];
    int wt=0,tat=0,time=0;

    printf("Enter number of processes: ");
    scanf("%d",&n);

    printf("Enter Burst Time:\n");
    for(i=0;i<n;i++)
    {
        scanf("%d",&bt[i]);
        rt[i]=bt[i];
    }

    printf("Enter Time Quantum: ");
    scanf("%d",&tq);

    remain=n;

    while(remain!=0)
    {
        for(i=0;i<n;i++)
        {
            if(rt[i]>0)
            {
                if(rt[i]<=tq)
                {
                    time+=rt[i];
                    wt+=time-bt[i];
                    tat+=time;
                    rt[i]=0;
                    remain--;
                }
                else
                {
                    time+=tq;
                    rt[i]-=tq;
                }
            }
        }
    }

    printf("\nAverage Waiting Time = %.2f",(float)wt/n);
    printf("\nAverage Turnaround Time = %.2f",(float)tat/n);

    return 0;
}
